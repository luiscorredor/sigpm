rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function isAdmin() {
      return activeUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Administrador";
    }

    // El empleado solo puede leer su propio perfil.
    // La gestión de cuentas está reservada al administrador.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Administrador y empleados activos pueden gestionar la operación.
    // Solo el administrador puede gestionar cuentas en /users.
    match /maquinas/{recordId} {
      allow read, create, update, delete: if activeUser();
    }

    match /mantenimientos/{recordId} {
      allow read, create, update, delete: if activeUser();
    }

    match /productos/{recordId} {
      allow read, create, update, delete: if activeUser();
    }

    match /produccion/{recordId} {
      allow read, create, update, delete: if activeUser();
    }

  
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
